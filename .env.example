# YottaFlex Lead Intelligence & Operations Console - Environment Configuration
# Copy this file to .env and adjust variables as needed.
# IMPORTANT: Never commit actual passwords or service-role keys to source control.

# Application Server (Backend)
HOST=127.0.0.1
PORT=8000

# Frontend API Configuration (Configured in Netlify / .env for frontend development)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Primary Supabase PostgreSQL Connection (Configured in Render and backend .env)
# Option A: Full Connection URI (Recommended for connection pooling)
DATABASE_URL=postgresql://postgres.your_project_id:your_supabase_password@aws-0-region.pooler.supabase.com:6543/postgres

# Option B: Discrete Parameters
SUPABASE_HOST=aws-0-region.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_DBNAME=postgres
SUPABASE_USER=postgres.your_project_id
SUPABASE_PASSWORD=your_supabase_database_password_here

# Local Offline Fallback Dataset Paths (Safely active when Supabase credentials are not configured)
DATA_DIR=data/generated_full
GROUND_TRUTH_DIR=data/ground_truth
SQL_DIR=sql
